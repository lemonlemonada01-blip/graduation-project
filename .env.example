# Neon Postgres (use the connection string from the Neon dashboard)
# DATABASE_URL=postgresql://USER:PASSWORD@ep-example.eu-central-1.aws.neon.tech/secure_feprh_db?sslmode=require

# Local PostgreSQL
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/secure_feprh_db

# Replace these defaults in any shared or deployed environment.
JWT_SECRET=replace-with-a-long-random-secret
BIOMETRIC_ENCRYPTION_KEY=replace-with-a-valid-fernet-key

# Optional connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
