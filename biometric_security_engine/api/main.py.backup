# --- Helper Methods ---
def _sse(msg_type: str, **kwargs) -> str:
    """Standardized SSE message formatter. Avoids f-string escaping hazards."""
    payload = {"type": msg_type, **kwargs}
    return f"data: {json.dumps(payload)}\n\n"

MAX_B64_SIZE_BYTES = 15 * 1024 * 1024

def decode_base64_image(b64_string: str) -> np.ndarray:
    try:
        if len(b64_string) > MAX_B64_SIZE_BYTES:
            raise ValueError("Image payload exceeds maximum allowed size (15MB).")
        if "," in b64_string:
            b64_string = b64_string.split(",")[1]
        img_data = base64.b64decode(b64_string)
        nparr = np.frombuffer(img_data, np.uint8)
        img = cv2.imdecode(nparr, cv2.IMREAD_COLOR)
        if img is None:
            raise ValueError("Decoded image is empty or corrupted.")
        return img
    except Exception as e:
        raise HTTPException(status_code=400, detail=f"Invalid Base64 Image: {e}")

def create_jwt_token(student_id: str) -> str:
    payload = {
        "sub": student_id,
        "exp": datetime.datetime.utcnow() + datetime.timedelta(hours=1),
        "iat": datetime.datetime.utcnow(),
    }
    return jwt.encode(payload, JWT_SECRET, algorithm="HS256")

