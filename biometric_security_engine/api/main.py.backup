@app.get("/api/health")
def health_check():
    return {
        "status": "healthy",
        "timestamp": datetime.datetime.utcnow().isoformat(),
        "biometrics": "online",
        "plagiarism": "online" if PLAGIARISM_AVAILABLE else "standby"
    }

@app.get("/api/biometrics/challenge/generate")
def generate_motion_challenge():
    """Generates a randomized 3D gesture challenge sequence for active liveness verification."""
    import random
    all_gestures = ["TURN_LEFT", "TURN_RIGHT", "LOOK_UP", "LOOK_DOWN"]
    selected = random.sample(all_gestures, 2)
    selected.append("CIRCULAR_MOTION")
    return {"challenges": selected}

@app.post("/api/biometrics/challenge/verify_step")
def verify_motion_step(payload: StepChallengePayload):
    """
    Verifies a single 3D motion step (TURN_LEFT, TURN_RIGHT, LOOK_UP, LOOK_DOWN, BLINK).
    Calculates exact Pitch, Yaw, and Roll Euler angles.
    """
    frame = decode_base64_image(payload.image_base64)
    try:
        _, _, landmarks = face_engine.extract_face(frame, strict_quality=False)
        result = ActiveLivenessDetector.verify_motion_challenge(landmarks, payload.challenge_type, frame.shape)
        if not result["passed"]:
            raise HTTPException(status_code=403, detail=f"Motion Challenge '{payload.challenge_type}' Failed. {result['detail']}")
        return {"status": "success", "detail": result["detail"], "angles": result["angles"]}
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))

@app.post("/api/biometrics/challenge/verify_circular")
def verify_circular_motion(payload: CircularChallengePayload):
    """Verifies a 360-degree circular head gesture across a sequence of frames."""
    angles_sequence = []
    for b64 in payload.frames_base64:
        frame = decode_base64_image(b64)
        try:
            _, _, landmarks = face_engine.extract_face(frame, strict_quality=False)
            angles = ActiveLivenessDetector.estimate_head_pose(landmarks, frame.shape)
            angles_sequence.append(angles)
        except ValueError:
            continue

    result = ActiveLivenessDetector.verify_circular_sequence(angles_sequence)
    if not result["passed"]:
        raise HTTPException(status_code=403, detail=f"Circular Motion Verification Failed. {result['detail']}")

    return {"status": "success", "message": "Circular Motion Verification Passed!", "detail": result["detail"]}

@app.post("/api/biometrics/register")
def register_face(student_id: str = Body(...), image_base64: str = Body(...), liveness_token: str = Body(None)):
    """Registers a face. Uses IQA Gate to reject poor quality photos."""
    frame = decode_base64_image(image_base64)
    try:
        embedding, bbox, _ = face_engine.extract_face(frame, strict_quality=True)
        if not liveness_token or liveness_token != 'motion_verified':
            raise HTTPException(status_code=403, detail="Liveness verification required. Please complete the 3D Motion Challenge first.")
            
        emb_str = ",".join(map(str, embedding))
        with get_db_connection() as conn:
            conn.execute("INSERT OR REPLACE INTO students (student_id, embedding) VALUES (?, ?)", (student_id, emb_str))
            conn.commit()
        
        return {
            "status": "success",
            "message": f"Student {student_id} successfully registered with high quality."
        }
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))

@app.post("/api/biometrics/authenticate")
def authenticate_face(payload: AuthPayload):
    """Authenticates a face against registered embeddings and returns a signed JWT token."""
    with get_db_connection() as conn:
        row = conn.execute("SELECT embedding FROM students WHERE student_id = ?", (payload.student_id,)).fetchone()
    
    if not row:
        raise HTTPException(status_code=404, detail=f"Student ID '{payload.student_id}' not found in database. Please register first.")
        
    stored_embedding = [float(x) for x in row['embedding'].split(',')]
    frame = decode_base64_image(payload.image_base64)
    
    try:
        live_embedding, bbox, _ = face_engine.extract_face(frame, strict_quality=False)
        is_match, distance = face_engine.verify_identity(live_embedding, stored_embedding)
        
        if is_match:
            token = create_jwt_token(payload.student_id)
            return {
                "authenticated": True,
                "token": token,
                "distance": distance,
                "message": "Identity Verified. Access Granted."
            }
        else:
            raise HTTPException(status_code=401, detail="Face does not match registered profile records.")
    except ValueError as e:
        raise HTTPException(status_code=400, detail=str(e))

@app.post("/api/biometrics/identify")
def identify_face(payload: ImagePayload, db: Session = Depends(get_rbac_db)):
    """Identifies WHO a person is among all enrolled students using 1:N face matching."""
    try:
        frame = decode_base64_image(payload.image_base64)
    except Exception as e:
        return {
            "authenticated": False,
            "student_id": None,
            "student_name": None,
            "distance": None,
            "message": f"Image decode failed: {str(e)}"
        }

    try:
        live_embedding, bbox, _ = face_engine.extract_face(frame, strict_quality=False)
    except ValueError as e:
        return {
            "authenticated": False,
            "student_id": None,
            "student_name": None,
            "distance": None,
            "message": str(e)
        }

    with get_db_connection() as conn:
        rows = conn.execute("SELECT student_id, embedding FROM students").fetchall()

    if not rows:
        return {
            "authenticated": False,
            "student_id": None,
            "student_name": None,
            "distance": None,
            "message": "No students registered in biometric database."
        }

    database = {
        row['student_id']: [float(x) for x in row['embedding'].split(',')]
        for row in rows
    }

    result = face_engine.search_1_to_n(live_embedding, database)

    if result["authenticated"]:
        student_id = result["student_id"]
        # Look up student full name from users table
        user = db.query(User).filter((User.email == student_id) | (User.id == student_id)).first()
        student_name = user.full_name if user else student_id
        return {
            "authenticated": True,
            "student_id": student_id,
            "student_name": student_name,
            "distance": round(result["distance"], 4),
            "message": f"Identity matched: {student_name} ({student_id})"
        }
    else:
        dist = result.get("distance")
        return {
            "authenticated": False,
            "student_id": None,
            "student_name": None,
            "distance": round(dist, 4) if dist is not None else None,
            "message": "Face not recognized. No matching student found in database."
        }

