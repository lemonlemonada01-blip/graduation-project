            "timestamp": r.timestamp
        }
        for r in records
    ]

@app.post("/api/sessions/{session_id}/clockin")
def clock_in_student(session_id: str, payload: ClockInPayload, db: Session = Depends(get_rbac_db)):
    """Clocks in a student with server-side Present/Late calculation based on session timing."""
    session = db.query(AcademicSession).filter(AcademicSession.id == session_id).first()
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")

    record = db.query(SessionAttendanceRecord).filter(
        SessionAttendanceRecord.session_id == session_id,
        SessionAttendanceRecord.student_id == payload.student_id
    ).first()

    now = datetime.datetime.now()
    now_str = now.strftime("%I:%M %p")

    # Compute Present vs Late from session start time + grace period
    computed_status = "Present"
    try:
        time_range = session.time_range  # e.g. "09:00 AM - 12:00 PM"
        start_str = time_range.split("-")[0].strip()
        session_date = datetime.datetime.strptime(session.date, "%Y-%m-%d").date()
        session_start = datetime.datetime.combine(
            session_date,
            datetime.datetime.strptime(start_str, "%I:%M %p").time()
        )
        grace_end = session_start + datetime.timedelta(minutes=session.grace_period or 15)
        if now > grace_end:
            computed_status = "Late"
    except Exception:
        computed_status = "Present"  # Fallback if parsing fails

    # Determine student name
    student_name = payload.student_name
    if not student_name or student_name.startswith("Student ") or student_name == payload.student_id:
        user = db.query(User).filter((User.email == payload.student_id) | (User.id == payload.student_id)).first()
        if user:
            student_name = user.full_name
        else:
            student_name = payload.student_name or payload.student_id

    if not record:
        record = SessionAttendanceRecord(
            session_id=session_id,
            student_id=payload.student_id,
            student_name=student_name,
            status=computed_status,
            verification_method=payload.verification_method,
            confidence=payload.confidence or "99.4%",
            timestamp=now_str
        )
        db.add(record)
        session.enrolled = (session.enrolled or 0) + 1
    else:
        record.student_name = student_name
        record.status = computed_status
        record.verification_method = payload.verification_method
        record.confidence = payload.confidence or "99.4%"
        record.timestamp = now_str

    db.commit()
    return {
        "status": "success",
        "message": f"Student {student_name} clocked in as {computed_status}.",
        "record": {
            "id": record.id,
            "student_id": record.student_id,
            "student_name": record.student_name,
            "status": record.status,
            "verification_method": record.verification_method,
            "confidence": record.confidence,
            "timestamp": record.timestamp
        }
    }

@app.get("/api/sessions/stats")
def get_attendance_stats(db: Session = Depends(get_rbac_db)):
    """Returns aggregated attendance statistics per session for trend charts."""
    sessions = db.query(AcademicSession).order_by(AcademicSession.created_at.desc()).limit(10).all()
    trend = []
    for s in reversed(sessions):
        records = db.query(SessionAttendanceRecord).filter(SessionAttendanceRecord.session_id == s.id).all()
        present_count = sum(1 for r in records if r.status == "Present")
        late_count = sum(1 for r in records if r.status == "Late")
        absent_count = sum(1 for r in records if r.status == "Absent")
        trend.append({
            "session": f"{s.course_code}",
            "session_name": s.course_name,
            "date": s.date,
            "present": present_count,
            "late": late_count,
            "absent": absent_count,
            "total": present_count + late_count + absent_count
        })
    return {"trend": trend}

