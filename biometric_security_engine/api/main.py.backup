@app.get("/api/reports/attendance-trends")
def get_reports_attendance_trends(db: Session = Depends(get_rbac_db)):
    sessions = db.query(AcademicSession).order_by(AcademicSession.created_at.desc()).limit(6).all()
    trend = []
    for s in reversed(sessions):
        records = db.query(SessionAttendanceRecord).filter(SessionAttendanceRecord.session_id == s.id).all()
        present = sum(1 for r in records if r.status == "Present")
        late = sum(1 for r in records if r.status == "Late")
        absent = sum(1 for r in records if r.status == "Absent")
        trend.append({
            "name": s.course_code,
            "Present": present,
            "Late": late,
            "Absent": absent
        })
    return {"trend": trend}

@app.get("/api/reports/team-activity")
def get_team_activity(db: Session = Depends(get_rbac_db)):
    teams = db.query(Team).limit(5).all()
    activity = []
    for t in teams:
        members_count = db.query(TeamMember).filter(TeamMember.team_id == t.id).count()
        activity.append({
            "team": t.name,
            "department": t.department,
            "members": members_count,
            "tasks_completed": 12,
            "status": "Active"
        })
    return {"teams": activity}

