@app.post("/api/projects/{project_id}/tasks", status_code=status.HTTP_201_CREATED)
def create_project_task(project_id: str, task: ProjectTaskCreate, db: Session = Depends(get_rbac_db)):
    p = db.query(Project).filter(Project.id == project_id).first()
    if not p:
        raise HTTPException(status_code=404, detail="Project not found")
    count = db.query(ProjectTask).filter(ProjectTask.project_id == project_id).count()
    new_t = ProjectTask(
        project_id=project_id,
        title=task.title,
        description=task.description,
        status=task.status,
        priority=task.priority,
        category=task.category,
        assignee_id=task.assignee_id,
        assignee_name=task.assignee_name,
        order_index=count
    )
    db.add(new_t)
    db.commit()
    db.refresh(new_t)
    return {"status": "success", "task_id": new_t.id}

