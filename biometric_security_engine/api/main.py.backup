@app.put("/api/meetings/{meeting_id}")
def update_meeting(meeting_id: int, payload: MeetingUpdate, db: Session = Depends(get_rbac_db)):
    m = db.query(Meeting).filter(Meeting.id == meeting_id).first()
    if not m:
        raise HTTPException(status_code=404, detail="Meeting not found")
    if payload.title is not None:
        m.title = payload.title
    if payload.project_id is not None:
        m.project_id = payload.project_id
    if payload.date is not None:
        m.date = payload.date
    if payload.time_range is not None:
        m.time_range = payload.time_range
    if payload.room is not None:
        m.room = payload.room
    if payload.notes is not None:
        m.notes = payload.notes
    if payload.status is not None:
        m.status = payload.status
    db.commit()
    return {"status": "success", "message": f"Meeting {meeting_id} updated."}

@app.delete("/api/meetings/{meeting_id}")
def delete_meeting(meeting_id: int, db: Session = Depends(get_rbac_db)):
    m = db.query(Meeting).filter(Meeting.id == meeting_id).first()
    if not m:
        raise HTTPException(status_code=404, detail="Meeting not found")
    db.delete(m)
    db.commit()
    return {"status": "success", "message": f"Meeting {meeting_id} deleted."}

@app.post("/api/meetings/{meeting_id}/verify")
def verify_meeting_attendee(meeting_id: int, payload: MeetingVerifyPayload, db: Session = Depends(get_rbac_db)):
    """Verifies attendance for a participant in a meeting."""
    m = db.query(Meeting).filter(Meeting.id == meeting_id).first()
    if not m:
        raise HTTPException(status_code=404, detail="Meeting not found")

    now_str = datetime.datetime.now().strftime("%Y-%m-%d %I:%M %p")
    att = db.query(MeetingAttendee).filter(
        MeetingAttendee.meeting_id == meeting_id,
        MeetingAttendee.student_name == payload.student_name
    ).first()

    if not att and payload.student_id:
        att = db.query(MeetingAttendee).filter(
            MeetingAttendee.meeting_id == meeting_id,
            MeetingAttendee.student_id == payload.student_id
        ).first()

    if att:
        att.is_verified = 1
        att.verification_method = payload.verification_method
        att.confidence = payload.confidence or "99.4%"
        att.timestamp = now_str
    else:
        att = MeetingAttendee(
            meeting_id=meeting_id,
            student_name=payload.student_name,
            student_id=payload.student_id or "--",
            is_verified=1,
            verification_method=payload.verification_method,
            confidence=payload.confidence or "99.4%",
            timestamp=now_str
        )
        db.add(att)

    # Recalculate meeting overall status
    db.commit()
    all_atts = db.query(MeetingAttendee).filter(MeetingAttendee.meeting_id == meeting_id).all()
    verified_count = sum(1 for a in all_atts if a.is_verified == 1)
    if verified_count == len(all_atts) and len(all_atts) > 0:
        m.status = "verified"
    elif verified_count > 0:
        m.status = "partial"
    else:
        m.status = "unverified"
    db.commit()

    return {
        "status": "success",
        "message": f"Participant {payload.student_name} verified for meeting.",
        "meeting_status": m.status
    }

