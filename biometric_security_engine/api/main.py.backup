@app.get("/api/meetings")
def get_all_meetings(db: Session = Depends(get_rbac_db)):
    """Returns all scheduled supervisory & defense meetings."""
    meetings = db.query(Meeting).order_by(Meeting.id.desc()).all()
    result = []
    for m in meetings:
        attendees = db.query(MeetingAttendee).filter(MeetingAttendee.meeting_id == m.id).all()
        result.append({
            "id": m.id,
            "title": m.title,
            "project_id": m.project_id or "--",
            "session_id": m.session_id,
            "date": m.date,
            "time_range": m.time_range,
            "room": m.room,
            "notes": m.notes or "",
            "status": m.status or "unverified",
            "attendees": [
                {
                    "id": a.id,
                    "student_name": a.student_name,
                    "student_id": a.student_id or "--",
                    "is_verified": bool(a.is_verified),
                    "verification_method": a.verification_method or "--",
                    "confidence": a.confidence or "--",
                    "timestamp": a.timestamp or "--"
                }
                for a in attendees
            ]
        })
    return {"meetings": result}

@app.post("/api/meetings", status_code=status.HTTP_201_CREATED)
def create_meeting(payload: MeetingCreate, db: Session = Depends(get_rbac_db)):
    """Creates a meeting and attaches initial attendees."""
    new_m = Meeting(
        title=payload.title,
        project_id=payload.project_id,
        session_id=payload.session_id,
        date=payload.date,
        time_range=payload.time_range,
        room=payload.room,
        notes=payload.notes,
        status=payload.status
    )
    db.add(new_m)
    db.commit()
    db.refresh(new_m)

    if payload.attendees:
        for att in payload.attendees:
            db.add(MeetingAttendee(
                meeting_id=new_m.id,
                student_name=att.student_name,
                student_id=att.student_id,
                is_verified=att.is_verified,
                verification_method=att.verification_method,
                confidence=att.confidence,
                timestamp=att.timestamp
            ))
        db.commit()

    db.add(AuditLog(
        action="Meeting Scheduled",
        details=f"Meeting '{new_m.title}' scheduled for {new_m.date} ({new_m.time_range})",
        ip_address="127.0.0.1"
    ))
    db.add(Notification(
        title=f"New Meeting: {new_m.title}",
        description=f"Scheduled on {new_m.date} in room {new_m.room}.",
        notif_type="info",
        link_route="/meetings"
    ))
    db.commit()

    return {"status": "success", "meeting_id": new_m.id, "title": new_m.title}

