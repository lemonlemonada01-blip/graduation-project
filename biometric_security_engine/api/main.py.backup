# 3. SESSIONS & ATTENDANCE MANAGEMENT ENDPOINTS
# ==============================================================================

@app.get("/api/sessions")
def get_all_sessions(db: Session = Depends(get_rbac_db)):
    """Returns list of all scheduled & active academic sessions."""
    sessions = db.query(AcademicSession).order_by(AcademicSession.created_at.desc()).all()
    results = []
    for s in sessions:
        results.append({
            "id": s.id,
            "courseCode": s.course_code,
            "courseName": s.course_name,
            "type": s.session_type,
            "room": s.room,
            "date": s.date,
            "timeRange": s.time_range,
            "gracePeriod": s.grace_period,
            "enrolled": s.enrolled or len(s.records),
            "status": s.status
        })
    return {"sessions": results}

@app.post("/api/sessions", status_code=status.HTTP_201_CREATED)
def create_session(payload: SessionCreate, db: Session = Depends(get_rbac_db)):
    """Creates a new academic session with enrolled students."""
    session_id = payload.id or f"S-{int(datetime.datetime.utcnow().timestamp()) % 10000}"
    
    new_session = AcademicSession(
        id=session_id,
        course_code=payload.course_code,
        course_name=payload.course_name,
        session_type=payload.session_type,
        room=payload.room,
        date=payload.date or datetime.date.today().strftime("%Y-%m-%d"),
        time_range=payload.time_range,
        grace_period=payload.grace_period,
        enrolled=payload.enrolled or (len(payload.student_ids) if payload.student_ids else 5),
        status=payload.status or "Upcoming"
    )
    db.add(new_session)
    db.commit()

    # If student IDs provided or default demo roster
    student_list = payload.student_ids or ["2024-CS-001", "2024-CS-002", "2024-CS-003", "2024-CS-004", "2024-CS-005"]
    for sid in student_list:
        db.add(SessionAttendanceRecord(
            session_id=session_id,
            student_id=sid,
            student_name=f"Student {sid}",
            status="Absent",
            verification_method="--",
            confidence="--",
            timestamp="--"
        ))
    db.commit()
    db.refresh(new_session)

    return {
        "status": "success",
        "message": f"Session '{new_session.course_name}' created successfully.",
        "session": {
            "id": new_session.id,
            "courseCode": new_session.course_code,
            "courseName": new_session.course_name,
            "type": new_session.session_type,
            "room": new_session.room,
            "date": new_session.date,
            "timeRange": new_session.time_range,
            "gracePeriod": new_session.grace_period,
            "enrolled": new_session.enrolled,
            "status": new_session.status
        }
    }

@app.put("/api/sessions/{session_id}")
def update_session(session_id: str, payload: SessionUpdate, db: Session = Depends(get_rbac_db)):
    """Updates an existing academic session."""
    session = db.query(AcademicSession).filter(AcademicSession.id == session_id).first()
    if not session:
        raise HTTPException(status_code=404, detail="Session not found")
    
    if payload.course_code is not None: session.course_code = payload.course_code
    if payload.course_name is not None: session.course_name = payload.course_name
    if payload.session_type is not None: session.session_type = payload.session_type
    if payload.room is not None: session.room = payload.room
    if payload.date is not None: session.date = payload.date
    if payload.time_range is not None: session.time_range = payload.time_range
    if payload.grace_period is not None: session.grace_period = payload.grace_period
    if payload.status is not None: session.status = payload.status

    db.commit()
    return {"status": "success", "message": "Session updated successfully."}

@app.delete("/api/sessions/{session_id}")
