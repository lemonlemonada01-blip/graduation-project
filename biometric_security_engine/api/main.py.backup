@app.post("/api/users/{user_id}/reset-password")
def reset_user_password_endpoint(user_id: int, db: Session = Depends(get_rbac_db)):
    """Generates a secure temporary password for the user."""
    user = db.query(User).filter(User.id == user_id).first()
    if not user:
        raise HTTPException(status_code=404, detail="User not found")
    import secrets
    temp_pass = f"Pass-{secrets.token_hex(4)}"
    user.hashed_password = temp_pass
    db.commit()
    return {
        "status": "success", 
        "message": f"Temporary password generated for {user.full_name}: {temp_pass}", 
        "temp_password": temp_pass
    }

