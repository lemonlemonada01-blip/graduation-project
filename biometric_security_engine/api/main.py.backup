@app.get("/api/projects")
def get_all_projects(db: Session = Depends(get_rbac_db)):
    """Returns all graduation & research projects with task metrics."""
    projects = db.query(Project).order_by(Project.created_at.desc()).all()
    result = []
    for p in projects:
        tasks = db.query(ProjectTask).filter(ProjectTask.project_id == p.id).all()
        deliverables = db.query(ProjectDeliverable).filter(ProjectDeliverable.project_id == p.id).all()
        result.append({
            "id": p.id,
            "title": p.title,
            "abstract": p.abstract or "",
            "domain": p.domain or "AI/ML",
            "status": p.status or "Proposed",
            "supervisor_id": p.supervisor_id,
            "supervisor_name": p.supervisor_name or "Dr. Ahmed Hassan",
            "team_id": p.team_id,
            "department": p.department or "Computer Science Dept.",
            "university": p.university or "Cairo University",
            "academic_year": p.academic_year or "2024/2025",
            "progress_percentage": p.progress_percentage or 0.0,
            "tasks_count": len(tasks),
            "deliverables_count": len(deliverables),
            "created_at": p.created_at.isoformat() if p.created_at else None
        })
    return {"projects": result}

@app.post("/api/projects", status_code=status.HTTP_201_CREATED)
def create_project(payload: ProjectCreate, db: Session = Depends(get_rbac_db)):
    """Creates a new graduation project."""
    project_id = payload.id
    if not project_id:
        count = db.query(Project).count() + 1
        project_id = f"PRJ-{count:03d}"

    existing = db.query(Project).filter(Project.id == project_id).first()
    if existing:
        raise HTTPException(status_code=400, detail="Project ID already exists")

    new_p = Project(
        id=project_id,
        title=payload.title,
        abstract=payload.abstract,
        domain=payload.domain,
        status=payload.status,
        supervisor_id=payload.supervisor_id,
        supervisor_name=payload.supervisor_name,
        team_id=payload.team_id,
        department=payload.department,
        university=payload.university,
        academic_year=payload.academic_year,
        progress_percentage=payload.progress_percentage
    )
    db.add(new_p)
    db.commit()
    db.refresh(new_p)

    db.add(AuditLog(
        action="Project Created",
        details=f"Project '{new_p.title}' ({new_p.id}) created under {new_p.department}",
        ip_address="127.0.0.1"
    ))
    db.commit()

    return {"status": "success", "project_id": new_p.id, "title": new_p.title}

@app.get("/api/projects/{project_id}")
def get_project_detail(project_id: str, db: Session = Depends(get_rbac_db)):
    """Returns project details, tasks, deliverables, and comments."""
    p = db.query(Project).filter(Project.id == project_id).first()
    if not p:
        # Check if project exists with fallback
        raise HTTPException(status_code=404, detail="Project not found")

    tasks = db.query(ProjectTask).filter(ProjectTask.project_id == p.id).order_by(ProjectTask.order_index.asc()).all()
    deliverables = db.query(ProjectDeliverable).filter(ProjectDeliverable.project_id == p.id).all()
    comments = db.query(ProjectComment).filter(ProjectComment.project_id == p.id).order_by(ProjectComment.created_at.desc()).all()

    return {
        "id": p.id,
        "title": p.title,
        "abstract": p.abstract or "",
        "domain": p.domain or "AI/ML",
        "status": p.status or "Proposed",
        "supervisor_name": p.supervisor_name or "Dr. Ahmed Hassan",
        "department": p.department or "Computer Science Dept.",
        "university": p.university or "Cairo University",
        "academic_year": p.academic_year or "2024/2025",
        "progress_percentage": p.progress_percentage or 0.0,
        "tasks": [
            {
                "id": t.id,
                "title": t.title,
                "description": t.description or "",
                "status": t.status,
                "priority": t.priority,
                "category": t.category,
                "assignee_name": t.assignee_name or "Unassigned",
                "order_index": t.order_index
            }
            for t in tasks
        ],
        "deliverables": [
            {
                "id": d.id,
                "name": d.name,
                "file_path": d.file_path,
                "file_size": d.file_size,
                "file_type": d.file_type,
                "uploader_name": d.uploader_name or "System",
                "uploaded_at": d.uploaded_at.isoformat() if d.uploaded_at else None
            }
            for d in deliverables
        ],
        "comments": [
            {
                "id": c.id,
                "user_id": c.user_id,
                "content": c.content,
                "created_at": c.created_at.isoformat() if c.created_at else None,
                "author_name": c.author.full_name if c.author else "System User"
            }
            for c in comments
        ]
    }

