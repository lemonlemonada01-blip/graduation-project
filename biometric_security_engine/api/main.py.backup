                time_range="11:00 AM - 12:30 PM",
                room="Virtual / Zoom",
                notes="Initial project scope and milestones sign-off with supervisory committee.",
                status="unverified"
            )
            db.add_all([m1, m2, m3])
            db.commit()

            m_attendees = [
                (m1.id, "Sarah Chen", "2024-CS-001", 1, "3D Biometric", "99.4%", f"{today_str} 10:02 AM"),
                (m1.id, "Omar Al-Farsi", "2024-CS-002", 1, "3D Biometric", "99.1%", f"{today_str} 10:04 AM"),
                (m1.id, "Fatima Al-Zadjali", "2024-CS-003", 1, "Fast Face ID", "98.5%", f"{today_str} 10:05 AM"),
                (m2.id, "Eng. Khalid Al-Mansoori", "FAC-002", 1, "3D Biometric", "99.8%", f"{today_str} 02:01 PM"),
                (m2.id, "Sarah Chen", "2024-CS-001", 0, "--", "--", "--"),
                (m3.id, "Tariq Al-Busaidi", "2024-CS-004", 0, "--", "--", "--"),
            ]
            for mid, sname, sid, is_v, meth, conf, ts in m_attendees:
                db.add(MeetingAttendee(
                    meeting_id=mid,
                    student_name=sname,
                    student_id=sid,
                    is_verified=is_v,
                    verification_method=meth,
                    confidence=conf,
                    timestamp=ts
                ))
            db.commit()

        # 5. Seed Notifications & Audit Logs
        if db.query(Notification).count() == 0:
            n1 = Notification(
                title="Plagiarism Alert: High Similarity Flagged (41%)",
                description="Project 'Autonomous Drone Navigation' flagged 41% AST token overlap with external repository.",
                notif_type="alert",
                link_route="/plagiarism"
            )
            n2 = Notification(
                title="Biometric Attendance Verified",
                description="Session CS401 Senior Project Defense achieved 100% verified attendance.",
                notif_type="success",
                link_route="/attendance"
            )
            n3 = Notification(
                title="New Supervisory Meeting Scheduled",
                description="Supervisor scheduled 'Mid-Term Milestone Evaluation' for today.",
                notif_type="info",
                link_route="/meetings"
            )
            db.add_all([n1, n2, n3])
            db.commit()

        if db.query(AuditLog).count() == 0:
            logs = [
                ("User Logged In", "Admin authenticated via Session Key", "127.0.0.1"),
                ("Biometric Model Initialized", "MiniFASNetV2 Liveness & MobileFaceNet ready", "127.0.0.1"),
                ("Plagiarism AST Engine Ready", "Loaded AST parsers for Python, JS/TS, C++, Java", "127.0.0.1"),
                ("Database Synchronized", "All 10 relational tables verified and linked", "127.0.0.1"),
            ]
            for act, det, ip in logs:
                db.add(AuditLog(
                    action=act,
                    details=det,
                    ip_address=ip
                ))
            db.commit()

    except Exception as e:
        print(f"[Warning] Extended seeding error: {e}")
    finally:
        db.close()

seed_initial_sessions()

def get_rbac_db():
    db = SessionLocal()
    try:
        yield db
    finally:
        db.close()

