@app.get("/api/teams")
def get_all_teams(db: Session = Depends(get_rbac_db)):
    """Returns all registered teams with member details."""
    teams = db.query(Team).order_by(Team.id.desc()).all()
    result = []
    for t in teams:
        members = db.query(TeamMember).filter(TeamMember.team_id == t.id).all()
        result.append({
            "id": t.id,
            "name": t.name,
            "description": t.description or "",
            "department": t.department or "Computer Science",
            "university": t.university or "Cairo University",
            "color_gradient": t.color_gradient or "from-indigo-500 to-purple-600",
            "leader_id": t.leader_id,
            "members_count": len(members),
            "members": [
                {
                    "id": m.id,
                    "team_id": m.team_id,
                    "user_id": m.user_id,
                    "name": m.name or "Team Member",
                    "email": m.email or "",
                    "role": m.role_in_team or "Member",
                    "phone": m.phone or "--",
                    "initials": m.initials or (m.name[:2].upper() if m.name else "TM")
                }
                for m in members
            ]
        })
    return {"teams": result}

@app.post("/api/teams", status_code=status.HTTP_201_CREATED)
def create_team(payload: TeamCreate, db: Session = Depends(get_rbac_db)):
    """Creates a new team and attaches members if provided."""
    new_team = Team(
        name=payload.name,
        description=payload.description,
        department=payload.department,
        university=payload.university,
        color_gradient=payload.color_gradient,
        leader_id=payload.leader_id
    )
    db.add(new_team)
    db.commit()
    db.refresh(new_team)

    if payload.members:
        for m in payload.members:
            db.add(TeamMember(
                team_id=new_team.id,
                user_id=m.user_id,
                name=m.name,
                email=m.email,
                role_in_team=m.role_in_team,
                phone=m.phone,
                initials=m.initials or (m.name[:2].upper() if m.name else "TM")
            ))
        db.commit()

    db.add(AuditLog(
        action="Team Created",
        details=f"Team '{new_team.name}' created with ID {new_team.id}",
        ip_address="127.0.0.1"
    ))
    db.commit()

    return {"status": "success", "team_id": new_team.id, "name": new_team.name}

