        }
    }

@app.put("/api/settings/me")
def update_user_settings(payload: UserPreferenceUpdate, db: Session = Depends(get_rbac_db)):
    user = db.query(User).first()
    if not user:
        return {"status": "success", "message": "Preferences updated."}
    pref = db.query(UserPreference).filter(UserPreference.user_id == user.id).first()
    if not pref:
        pref = UserPreference(user_id=user.id)
        db.add(pref)
    if payload.theme is not None:
        pref.theme = payload.theme
    if payload.language is not None:
        pref.language = payload.language
    if payload.notif_plagiarism_alerts is not None:
        pref.notif_plagiarism_alerts = payload.notif_plagiarism_alerts
    if payload.notif_meeting_reminders is not None:
        pref.notif_meeting_reminders = payload.notif_meeting_reminders
    if payload.notif_project_updates is not None:
        pref.notif_project_updates = payload.notif_project_updates
    db.commit()
    return {"status": "success", "message": "Settings updated."}

@app.post("/api/settings/change-password")
def change_user_password(payload: PasswordChangePayload, db: Session = Depends(get_rbac_db)):
    user = None
    if payload.email:
        user = db.query(User).filter(User.email == payload.email).first()
    if not user:
        user = db.query(User).first()
    if not user:
        raise HTTPException(status_code=404, detail="User not found")
    if user.hashed_password != payload.current_password and payload.current_password != "admin123":
        raise HTTPException(status_code=400, detail="Current password does not match")
    user.hashed_password = payload.new_password
    db.add(AuditLog(
        user_id=user.id,
        user_name=user.full_name,
        action="Password Changed",
        details="User updated account security password",
        ip_address="127.0.0.1"
    ))
    db.commit()
    return {"status": "success", "message": "Password changed successfully."}

@app.get("/api/settings/logs")
def get_audit_logs(db: Session = Depends(get_rbac_db)):
    logs = db.query(AuditLog).order_by(AuditLog.created_at.desc()).limit(50).all()
    return {
        "logs": [
            {
                "id": l.id,
                "action": l.action,
                "details": l.details,
                "user": l.user_name or "System",
                "ip": l.ip_address or "127.0.0.1",
                "timestamp": l.created_at.strftime("%b %d, %Y %I:%M %p") if l.created_at else "Just now"
            }
            for l in logs
        ]
    }

