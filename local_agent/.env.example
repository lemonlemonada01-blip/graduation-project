# Required: create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter's free router dynamically selects an available free model.
OPENROUTER_MODEL=openrouter/free
# Optional comma-separated fallbacks. Leave empty to use catalog discovery.
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_SITE_URL=http://localhost
OPENROUTER_APP_NAME=Local OpenRouter Agent

# Runtime controls
AGENT_MAX_ITERATIONS=12
AGENT_TOOL_OUTPUT_LIMIT=12000
AGENT_COMMAND_TIMEOUT=30
AGENT_WORKSPACE=./workspace
AGENT_STATE_DIR=./.agent_state
